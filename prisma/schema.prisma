generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  ADJUSTMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings          UserSettings?
  portfolios        Portfolio[]
  transactions      Transaction[]
  portfolioHoldings PortfolioHolding[]
}

model UserSettings {
  id                        String         @id @default(cuid())
  userId                    String         @unique
  timezone                  String         @default("America/New_York")
  defaultCurrency           String         @default("USD")
  emailNotificationsEnabled Boolean        @default(true)
  morningBriefEnabled       Boolean        @default(true)
  marketCloseReportEnabled  Boolean        @default(false)
  weeklyReviewEnabled       Boolean        @default(true)
  riskTolerance             RiskTolerance?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id           String   @id @default(cuid())
  userId       String
  name         String
  baseCurrency String   @default("USD")
  description  String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  holdings     PortfolioHolding[]

  @@index([userId])
}

model Company {
  id           String   @id @default(cuid())
  tickerSymbol String   @unique
  name         String
  exchange     String?
  currency     String   @default("USD")
  sector       String?
  industry     String?
  country      String?
  website      String?
  description  String?
  cik          String?
  isin         String?
  figi         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions      Transaction[]
  portfolioHoldings PortfolioHolding[]
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  portfolioId  String
  companyId    String?
  tickerSymbol String
  type         TransactionType
  tradeDate    DateTime
  quantity     Decimal         @db.Decimal(20, 6)
  price        Decimal?        @db.Decimal(20, 6)
  fees         Decimal         @default(0) @db.Decimal(20, 6)
  currency     String          @default("USD")
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([portfolioId])
  @@index([tickerSymbol])
  @@index([tradeDate])
  @@index([portfolioId, tradeDate])
}

model PortfolioHolding {
  id                  String    @id @default(cuid())
  userId              String
  portfolioId         String
  companyId           String?
  tickerSymbol        String
  quantity            Decimal   @db.Decimal(20, 6)
  averageCost         Decimal?  @db.Decimal(20, 6)
  costBasis           Decimal?  @db.Decimal(20, 6)
  lastPrice           Decimal?  @db.Decimal(20, 6)
  marketValue         Decimal?  @db.Decimal(20, 6)
  unrealizedGainLoss  Decimal?  @db.Decimal(20, 6)
  unrealizedGainPct   Decimal?  @db.Decimal(12, 6)
  currency            String    @default("USD")
  lastPriceUpdatedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([portfolioId])
  @@index([tickerSymbol])
}
